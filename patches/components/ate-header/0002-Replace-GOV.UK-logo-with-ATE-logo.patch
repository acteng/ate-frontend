From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mark Hobson <mark.hobson@activetravelengland.gov.uk>
Date: Tue, 15 Sep 2026 17:49:49 +0100
Subject: [PATCH] Replace GOV.UK logo with ATE logo

---
 src/ate/components/ate-header/template.njk | 7 ++-----
 1 file changed, 2 insertions(+), 5 deletions(-)

diff --git a/src/ate/components/ate-header/template.njk b/src/ate/components/ate-header/template.njk
index c7dff16..64606e4 100644
--- a/src/ate/components/ate-header/template.njk
+++ b/src/ate/components/ate-header/template.njk
@@ -1,11 +1,8 @@
 {% from "govuk/components/generic-header/macro.njk" import govukGenericHeader -%}
-{% from "govuk/macros/logo.njk" import govukLogo -%}
 
 {% set logoContent %}
-  {{ govukLogo({
-    classes: "govuk-header__logotype",
-    ariaLabelText: "GOV.UK"
-  }) | trim | indent(8) }}
+  <img class="govuk-header__logotype ate-header__logotype" src="{{ params.assetPath }}/ate-header/ate-logo-white.png" alt="Active Travel England"/>
+  <img class="govuk-header__logotype ate-header__logotype--focus" src="{{ params.assetPath }}/ate-header/ate-logo-black.png" alt="Active Travel England"/>
   {%- if (params.productName) %}
     <span class="govuk-header__product-name">
       {{- params.productName -}}
-- 
2.43.0

